# Python bytecode and build output
__pycache__/
*.py[cod]
build/
*.egg-info/

# bin holds the built programs (made by packaging/build.ps1); only FFmpeg is kept in git
bin/*
!bin/ffmpeg.exe
!bin/ffprobe.exe

# Local environments and tool caches
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Hidden, half-made files from a conversion that was stopped
.*.partial.*

# Songs you convert here stay on your PC and are never uploaded
*.mp3
*.flac
*.wav
*.m4a
*.opus
